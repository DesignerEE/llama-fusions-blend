+template <int block_size, int vpt, bool write_ds4, bool write_d4>
+static __global__ void add_rms_norm_mul_quant_f32_kernel(
+        const float * src0_ptr,
+        const float * src1_ptr,
+        const float * mul_w_ptr,
+        float *       dst_add_ptr,
+        float *       dst_mul_ptr,
+        int4 *        vy_ds4_ptr,
+        int4 *        vy_d4_ptr,
+        const int     nrows,
+        const int     ncols4,
+        const int     ncols,
+        const float   eps) {
+    ggml_cuda_pdl_lc();
+    const int row = blockIdx.x;
+    const int tid = threadIdx.x;
+    int4 * GGML_CUDA_RESTRICT vy_ds4 = vy_ds4_ptr;
+    int4 * GGML_CUDA_RESTRICT vy_d4  = vy_d4_ptr;
+
+    if (row >= nrows) {
+        ggml_cuda_pdl_sync();
+#pragma unroll
+        for (int k = 0; k < vpt; ++k) {
+            const int i = tid + k * block_size;
+            if (i < ncols4) {
+                norm_zero_mmq_few_q8_1<write_ds4, write_d4>(row, i * 4, vy_ds4, vy_d4);
+            }
+        }
+        return;
+    }
+
+    const float * GGML_CUDA_RESTRICT src0    = src0_ptr;
+    const float * GGML_CUDA_RESTRICT src1    = src1_ptr;
+    const float * GGML_CUDA_RESTRICT mul_w   = mul_w_ptr;
+    float *       GGML_CUDA_RESTRICT dst_add = dst_add_ptr;
+    float *       GGML_CUDA_RESTRICT dst_mul = dst_mul_ptr;
+
+    extern __shared__ float s_sum[];
+
+    ggml_cuda_pdl_sync();
+
+    const int64_t row_off4 = (int64_t) row * ncols4;
+    const float4 * s0 = ((const float4 *) src0)    + row_off4;
+    const float4 * s1 = ((const float4 *) src1)    + row_off4;
+    const float4 * mw = (const float4 *)  mul_w;
+    float4 *       da = ((float4 *)       dst_add) + row_off4;
+    float4 *       dm = ((float4 *)       dst_mul) + row_off4;
+
+    float4 xs[vpt];
+    float  tmp = 0.0f;
+
+#pragma unroll
+    for (int k = 0; k < vpt; ++k) {
+        const int i = tid + k * block_size;
+        if (i < ncols4) {
+            const float4 a = s0[i];
+            const float4 b = s1[i];
+            const float4 s = make_float4(a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w);
+            da[i] = s;
+            xs[k] = s;
+            tmp  += s.x * s.x + s.y * s.y + s.z * s.z + s.w * s.w;
+        }
+    }
+
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+    const float scale = rsqrtf(tmp / ncols + eps);
+
+#pragma unroll
+    for (int k = 0; k < vpt; ++k) {
+        const int i = tid + k * block_size;
+        if (i < ncols4) {
+            const float4 m = mw[i];
+            const float4 r = make_float4(
+                (scale * xs[k].x) * m.x,
+                (scale * xs[k].y) * m.y,
+                (scale * xs[k].z) * m.z,
+                (scale * xs[k].w) * m.w);
+            dm[i] = r;
+            norm_store_mmq_few_q8_1<write_ds4, write_d4>(r, row, i * 4, vy_ds4, vy_d4);
+        }
+    }
+}
+
+void ggml_cuda_op_add_rms_norm_fused(ggml_backend_cuda_context & ctx,
+                                     ggml_tensor *               add_tensor,
+                                     ggml_tensor *               rms_norm_tensor,
+                                     ggml_tensor *               mul_tensor,
+                                     bool                        prequant_ds4,
+                                     bool                        prequant_d4) {
+    const ggml_tensor * src0  = add_tensor->src[0];
+    const ggml_tensor * src1  = add_tensor->src[1];
+    const ggml_tensor * mul_w = (mul_tensor->src[0] == rms_norm_tensor) ? mul_tensor->src[1] : mul_tensor->src[0];
+
+    float eps = 0.0f;
+    memcpy(&eps, rms_norm_tensor->op_params, sizeof(float));
+
+    const int ncols  = (int) add_tensor->ne[0];
+    const int n4     = ncols / 4;
+    const int nrows  = (int) ggml_nrows(add_tensor);
+    cudaStream_t stream = ctx.stream();
+
+    // Fused pre-quantization into static q8_1 scratch for few-row MMQ (4 <= nrows <= 8, ncols multiple of 256)
+    if ((prequant_ds4 || prequant_d4) && ctx.prequant_ds4 != nullptr &&
+            mul_tensor->ne[2] == 1 && mul_tensor->ne[3] == 1 &&
+            nrows >= 4 && nrows <= MMQ_FEW_NCOLS &&
+            ncols % QK_K == 0 && (ncols / QK_K) <= ggml_backend_cuda_context::PREQUANT_MAX_UNITS &&
+            n4 > 1024 && n4 <= 4096) {
+        const dim3 q_blocks(MMQ_FEW_NCOLS, 1, 1);
+        const dim3 q_threads(1024, 1, 1);
+        const size_t shmem = 32 * sizeof(float);
+        const ggml_cuda_kernel_launch_params lp{ q_blocks, q_threads, shmem, stream };
+        if (prequant_ds4 && prequant_d4) {
+            ggml_cuda_kernel_launch((add_rms_norm_mul_quant_f32_kernel<1024, 4, true, true>), lp,
+                (const float *) src0->data, (const float *) src1->data, (const float *) mul_w->data,
+                (float *) add_tensor->data, (float *) mul_tensor->data,
+                ctx.prequant_ds4, ctx.prequant_d4, nrows, n4, ncols, eps);
+        } else if (prequant_ds4) {
+            ggml_cuda_kernel_launch((add_rms_norm_mul_quant_f32_kernel<1024, 4, true, false>), lp,
+                (const float *) src0->data, (const float *) src1->data, (const float *) mul_w->data,
+                (float *) add_tensor->data, (float *) mul_tensor->data,
+                ctx.prequant_ds4, ctx.prequant_d4, nrows, n4, ncols, eps);
+        } else {
+            ggml_cuda_kernel_launch((add_rms_norm_mul_quant_f32_kernel<1024, 4, false, true>), lp,
+                (const float *) src0->data, (const float *) src1->data, (const float *) mul_w->data,
+                (float *) add_tensor->data, (float *) mul_tensor->data,
+                ctx.prequant_ds4, ctx.prequant_d4, nrows, n4, ncols, eps);
+        }
+        ctx.prequant_src_data = mul_tensor->data;
+        ctx.prequant_ne0      = ncols;
+        ctx.prequant_ne1      = nrows;
+        ctx.prequant_has_ds4  = prequant_ds4;
+        ctx.prequant_has_d4   = prequant_d4;
+        ctx.prequant_gen++;
+        return;
+    }
+
+    const dim3 blocks_num(nrows, 1, 1);
+#define ADD_RMS_LAUNCH(BS, VPT) \
+    do { \
+        const dim3 block_dims(BS, 1, 1); \
+        const size_t shmem = (BS > WARP_SIZE) ? 32 * sizeof(float) : 0; \
+        const ggml_cuda_kernel_launch_params lp{ blocks_num, block_dims, shmem, stream }; \
+        ggml_cuda_kernel_launch((add_rms_norm_mul_f32_kernel<BS, VPT>), lp, \
+            (const float *) src0->data, (const float *) src1->data, (const float *) mul_w->data, \
+            (float *) add_tensor->data, (float *) mul_tensor->data, n4, ncols, eps); \
+    } while (0)
+
+    if (n4 <= 32) {
+        ADD_RMS_LAUNCH(32, 1);
+    } else if (n4 <= 128) {
+        ADD_RMS_LAUNCH(128, 1);
+    } else if (n4 <= 256) {
+        ADD_RMS_LAUNCH(256, 1);
+    } else if (n4 <= 512) {
+        ADD_RMS_LAUNCH(512, 1);
+    } else if (n4 <= 1024) {
+        ADD_RMS_LAUNCH(1024, 1);
+    } else {
+        ADD_RMS_LAUNCH(1024, 4);
+    }
+#undef ADD_RMS_LAUNCH
+}
+
+static __global__ void rms_norm_gated_silu_128_f32_kernel(
+        const float * x_ptr,
+        const float * mul_w_ptr,
+        const float * gate_ptr,
+        float *       dst_ptr,
+        const int     nrows_tot,
+        const float   eps) {
+    ggml_cuda_pdl_lc();
+    const float * GGML_CUDA_RESTRICT x     = x_ptr;
+    const float * GGML_CUDA_RESTRICT mul_w = mul_w_ptr;
+    const float * GGML_CUDA_RESTRICT gate  = gate_ptr;
+    float *       GGML_CUDA_RESTRICT dst   = dst_ptr;
+    const int row = blockIdx.x * blockDim.y + threadIdx.y;
+    const int tid = threadIdx.x;
+
+    ggml_cuda_pdl_sync();
+    if (row >= nrows_tot) {
+        return;
+    }
+
+    const int64_t off4 = (int64_t) row * 32 + tid;
+    const float4 xs = ((const float4 *) x)[off4];
+    float tmp = xs.x * xs.x + xs.y * xs.y + xs.z * xs.z + xs.w * xs.w;
+    tmp = warp_reduce_sum<WARP_SIZE>(tmp);
+    const float scale = rsqrtf(tmp * (1.0f / 128.0f) + eps);
+
+    const float4 m = ((const float4 *) mul_w)[tid];
+    const float4 g = ((const float4 *) gate)[off4];
+    const float4 r = make_float4(
+        ((scale * xs.x) * m.x) * ggml_cuda_op_silu_single(g.x),
+        ((scale * xs.y) * m.y) * ggml_cuda_op_silu_single(g.y),
+        ((scale * xs.z) * m.z) * ggml_cuda_op_silu_single(g.z),
+        ((scale * xs.w) * m.w) * ggml_cuda_op_silu_single(g.w));
+    ((float4 *) dst)[off4] = r;
+}
+
+static __global__ void rms_norm_gated_silu_128_quant_f32_kernel(
+        const float * x_ptr,
+        const float * mul_w_ptr,
+        const float * gate_ptr,
+        float *       dst_ptr,
+        int4 *        vy_ds4_ptr,
+        int4 *        vy_d4_ptr,
+        const int     n_heads,
+        const int     n_tokens,
+        const float   eps) {
+    ggml_cuda_pdl_lc();
+    const int row = blockIdx.x * blockDim.y + threadIdx.y;
+    const int tid = threadIdx.x;
+    const int nrows_pad = n_heads * MMQ_FEW_NCOLS;
+
+    ggml_cuda_pdl_sync();
+    if (row >= nrows_pad) {
+        return;
+    }
+
+    const int tok  = row / n_heads;
+    const int head = row % n_heads;
+    const int i0   = head * 128 + tid * 4;
+    int4 * GGML_CUDA_RESTRICT vy_ds4 = vy_ds4_ptr;
+    int4 * GGML_CUDA_RESTRICT vy_d4  = vy_d4_ptr;
+
+    if (tok >= n_tokens) {
+        norm_zero_mmq_few_q8_1<true, false>(tok, i0, vy_ds4, vy_d4);
+        return;
+    }
+
+    const float * GGML_CUDA_RESTRICT x     = x_ptr;
+    const float * GGML_CUDA_RESTRICT mul_w = mul_w_ptr;
+    const float * GGML_CUDA_RESTRICT gate  = gate_ptr;
+    float *       GGML_CUDA_RESTRICT dst   = dst_ptr;
+
+    const int64_t off4 = (int64_t) row * 32 + tid;
+    const float4 xs = ((const float4 *) x)[off4];
+    float tmp = xs.x * xs.x + xs.y * xs.y + xs.z * xs.z + xs.w * xs.w;
+    tmp = warp_reduce_sum<WARP_SIZE>(tmp);
+    const float scale = rsqrtf(tmp * (1.0f / 128.0f) + eps);
+
+    const float4 m = ((const float4 *) mul_w)[tid];
+    const float4 g = ((const float4 *) gate)[off4];
+    const float4 r = make_float4(
+        ((scale * xs.x) * m.x) * ggml_cuda_op_silu_single(g.x),
+        ((scale * xs.y) * m.y) * ggml_cuda_op_silu_single(g.y),
+        ((scale * xs.z) * m.z) * ggml_cuda_op_silu_single(g.z),
+        ((scale * xs.w) * m.w) * ggml_cuda_op_silu_single(g.w));
+    ((float4 *) dst)[off4] = r;
+    norm_store_mmq_few_q8_1<true, false>(r, tok, i0, vy_ds4, vy_d4);
+}
+
+void ggml_cuda_op_rms_norm_gated_silu(ggml_backend_cuda_context & ctx,
+                                      ggml_tensor *               rms_norm_tensor,
+                                      ggml_tensor *               mul_w_tensor,
+                                      ggml_tensor *               silu_tensor,
+                                      ggml_tensor *               dst_tensor) {
+    const ggml_tensor * x     = rms_norm_tensor->src[0];
+    const ggml_tensor * mul_w = (mul_w_tensor->src[0] == rms_norm_tensor) ? mul_w_tensor->src[1] : mul_w_tensor->src[0];
+    const ggml_tensor * gate  = silu_tensor->src[0];
+
+    float eps = 0.0f;
+    memcpy(&eps, rms_norm_tensor->op_params, sizeof(float));
+
+    const int n_heads  = (int) x->ne[1];
+    const int n_tokens = (int) x->ne[2];
+    const int ne00     = (int) (x->ne[0] * x->ne[1]);
+    constexpr int warps_per_cta = 4;
+
+    if (ctx.prequant_ds4 != nullptr &&
+            x->ne[0] == 128 && x->ne[3] == 1 &&
+            n_tokens >= 4 && n_tokens <= MMQ_FEW_NCOLS &&
+            ne00 % QK_K == 0 && (ne00 / QK_K) <= ggml_backend_cuda_context::PREQUANT_MAX_UNITS) {
+        const int nrows_pad = n_heads * MMQ_FEW_NCOLS;
+        const dim3 blocks_num((nrows_pad + warps_per_cta - 1) / warps_per_cta, 1, 1);
