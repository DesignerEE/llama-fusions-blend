+    ggml_tensor ** n = cgraph->nodes + i;
+    const ggml_tensor * src1 = n[0]->src[1];
+    if (!src1 || src1->type != GGML_TYPE_F32 || src1->nb[0] != sizeof(float) || src1->ne[2] != 1 || src1->ne[3] != 1) {
+        return false;
+    }
+    if (!ggml_cuda_horiz_weight_ok(n[0], src1) || !ggml_cuda_horiz_weight_ok(n[2], src1) ||
+        !ggml_cuda_horiz_weight_ok(n[3], src1) || !ggml_cuda_horiz_weight_ok(n[6], src1)) {
+        return false;
+    }
+    if (n[1]->src[0] != n[0] || n[4]->src[0] != n[3] || n[5]->src[0] != n[4] ||
+        n[7]->src[0] != n[6] || n[9]->src[0] != n[8] || n[11]->src[0] != n[10]) {
+        return false;
+    }
+    if (ggml_get_unary_op(n[5]) != GGML_UNARY_OP_SIGMOID || ggml_get_unary_op(n[9]) != GGML_UNARY_OP_SOFTPLUS) {
