+template <int block_size, int vpt>
+static __global__ void add_rms_norm_mul_f32_kernel(
+        const float * src0_ptr,
+        const float * src1_ptr,
+        const float * mul_w_ptr,
+        float *       dst_add_ptr,
+        float *       dst_mul_ptr,
+        const int     ncols4,
+        const int     ncols,
+        const float   eps) {
+    ggml_cuda_pdl_lc();
+    const float * GGML_CUDA_RESTRICT src0    = src0_ptr;
+    const float * GGML_CUDA_RESTRICT src1    = src1_ptr;
+    const float * GGML_CUDA_RESTRICT mul_w   = mul_w_ptr;
+    float *       GGML_CUDA_RESTRICT dst_add = dst_add_ptr;
+    float *       GGML_CUDA_RESTRICT dst_mul = dst_mul_ptr;
+    const int row = blockIdx.x;
+    const int tid = threadIdx.x;
+
+    extern __shared__ float s_sum[];
+
+    ggml_cuda_pdl_sync();
+
+    const int64_t row_off4 = (int64_t) row * ncols4;
+    const float4 * s0 = ((const float4 *) src0)    + row_off4;
+    const float4 * s1 = ((const float4 *) src1)    + row_off4;
+    const float4 * mw = (const float4 *)  mul_w;
+    float4 *       da = ((float4 *)       dst_add) + row_off4;
+    float4 *       dm = ((float4 *)       dst_mul) + row_off4;
+
+    float4 xs[vpt];
+    float  tmp = 0.0f;
+
+#pragma unroll
+    for (int k = 0; k < vpt; ++k) {
+        const int i = tid + k * block_size;
+        if (i < ncols4) {
+            const float4 a = s0[i];
+            const float4 b = s1[i];
+            const float4 s = make_float4(a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w);
+            da[i] = s;
+            xs[k] = s;
+            tmp  += s.x * s.x + s.y * s.y + s.z * s.z + s.w * s.w;
+        }
+    }
+
+    tmp = block_reduce<block_reduce_method::SUM, block_size>(tmp, s_sum);
+    const float scale = rsqrtf(tmp / ncols + eps);
+
+#pragma unroll
+    for (int k = 0; k < vpt; ++k) {
+        const int i = tid + k * block_size;
+        if (i < ncols4) {
+            const float4 m = mw[i];
+            const float4 r = make_float4(
+                (scale * xs[k].x) * m.x,
+                (scale * xs[k].y) * m.y,
+                (scale * xs[k].z) * m.z,
+                (scale * xs[k].w) * m.w);
+            dm[i] = r;
+        }
+    }
+}
+
+template <bool write_ds4, bool write_d4>
+static __device__ __forceinline__ void norm_store_mmq_few_q8_1(
+        const float4 r, const int row_g, const int i0,
+        int4 * GGML_CUDA_RESTRICT vy_ds4, int4 * GGML_CUDA_RESTRICT vy_d4) {
+    float amax = fmaxf(fmaxf(fabsf(r.x), fabsf(r.y)), fmaxf(fabsf(r.z), fabsf(r.w)));
+    amax = warp_reduce_max<8>(amax);
+
+    const float d_inv = 127.0f / amax;
+    char4 q;
+    q.x = roundf(r.x * d_inv);
+    q.y = roundf(r.y * d_inv);
+    q.z = roundf(r.z * d_inv);
+    q.w = roundf(r.w * d_inv);
+    const float d = 1.0f / d_inv;
+    [[maybe_unused]] float sum = 0.0f;
+    if constexpr (write_ds4) {
+        sum = d * warp_reduce_sum<8>(float(q.x + q.y + q.z + q.w));
+    }
+
+    const int64_t off = (i0 / QK_K) * MMQ_FEW_Q8_1_INT4;
+    const int iu    = i0 % QK_K;
+    const int s     = iu / QK8_1;
+    const int k     = iu % QK8_1;
+    const int q_int = *(const int *) &q;
+    if constexpr (write_ds4) {
+        int4 * yg_ds4 = vy_ds4 + off;
+        ((int *) (yg_ds4 + (s/2)*WARP_SIZE + 4*row_g + (k % 16)/4))[2*(s % 2) + k/16] = q_int;
+        if (k == 0) {
+            ((half2 *) (yg_ds4 + 4*WARP_SIZE + 4*(row_g/2) + s/2))[2*(s % 2) + row_g % 2] = make_half2(d, sum);
+        }
+    }
+    if constexpr (write_d4) {
+        int4 * yg_d4 = vy_d4 + off;
+        ((int *) (yg_d4 + (s/2)*WARP_SIZE + 4*row_g + (k % 16)/4))[2*(s % 2) + k/16] = q_int;
+        if (k == 0) {
+            ((float *) (yg_d4 + 4*WARP_SIZE + 4*(row_g/2) + s/2))[2*(s % 2) + row_g % 2] = d;
+        }
+    }
+}
+
+template <bool write_ds4, bool write_d4>
+static __device__ __forceinline__ void norm_zero_mmq_few_q8_1(
+        const int row_g, const int i0,
+        int4 * GGML_CUDA_RESTRICT vy_ds4, int4 * GGML_CUDA_RESTRICT vy_d4) {
+    const int64_t off = (i0 / QK_K) * MMQ_FEW_Q8_1_INT4;
+    const int iu = i0 % QK_K;
+    const int s  = iu / QK8_1;
+    const int k  = iu % QK8_1;
+    if constexpr (write_ds4) {
+        int4 * yg_ds4 = vy_ds4 + off;
+        ((int *) (yg_ds4 + (s/2)*WARP_SIZE + 4*row_g + (k % 16)/4))[2*(s % 2) + k/16] = 0;
+        if (k == 0) {
+            ((half2 *) (yg_ds4 + 4*WARP_SIZE + 4*(row_g/2) + s/2))[2*(s % 2) + row_g % 2] = make_half2(0.0f, 0.0f);
+        }
+    }
+    if constexpr (write_d4) {
+        int4 * yg_d4 = vy_d4 + off;
+        ((int *) (yg_d4 + (s/2)*WARP_SIZE + 4*row_g + (k % 16)/4))[2*(s % 2) + k/16] = 0;
+        if (k == 0) {
+            ((float *) (yg_d4 + 4*WARP_SIZE + 4*(row_g/2) + s/2))[2*(s % 2) + row_g % 2] = 0.0f;
+        }
+    }
+}
