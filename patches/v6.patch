+static void top_k_small_cuda(
+        ggml_cuda_pool & pool,
+        const float * src, int * dst, int ncols, int k, cudaStream_t stream) {
+    constexpr int BLOCK_SIZE = 256;
+    constexpr int NBLOCKS    = TOP_K_SMALL_BLOCKS;
+    ggml_cuda_pool_alloc<float> tmp_vals(pool, NBLOCKS * k);
+    ggml_cuda_pool_alloc<int>   tmp_idxs(pool, NBLOCKS * k);
+
+    const ggml_cuda_kernel_launch_params p1 = ggml_cuda_kernel_launch_params(dim3(NBLOCKS, 1, 1), dim3(BLOCK_SIZE, 1, 1), 0, stream);
+    ggml_cuda_kernel_launch(top_k_small_stage1_f32<BLOCK_SIZE>, p1, src, tmp_vals.get(), tmp_idxs.get(), ncols, k);
+
+    const ggml_cuda_kernel_launch_params p2 = ggml_cuda_kernel_launch_params(dim3(1, 1, 1), dim3(NBLOCKS, 1, 1), 0, stream);
+    ggml_cuda_kernel_launch(top_k_small_stage2_f32<NBLOCKS>, p2, tmp_vals.get(), tmp_idxs.get(), dst, k);
+}
