+static constexpr int TOP_K_SMALL_MAX_K  = 16;
+static constexpr int TOP_K_SMALL_BLOCKS = 128;
+
+static __device__ __forceinline__ void top_k_small_insert(
+        float (&best_v)[TOP_K_SMALL_MAX_K], int (&best_i)[TOP_K_SMALL_MAX_K], int k, float val, int idx) {
+    if (val < best_v[k - 1] || (val == best_v[k - 1] && idx >= best_i[k - 1])) {
+        return;
+    }
+    int pos = k - 1;
+    while (pos > 0 && (val > best_v[pos - 1] || (val == best_v[pos - 1] && idx < best_i[pos - 1]))) {
+        best_v[pos] = best_v[pos - 1];
+        best_i[pos] = best_i[pos - 1];
+        --pos;
+    }
+    best_v[pos] = val;
+    best_i[pos] = idx;
+}
+
+template <int BLOCK_SIZE>
+static __global__ void top_k_small_stage1_f32(
+        const float * __restrict__ src,
+        float * __restrict__ tmp_vals,
+        int * __restrict__ tmp_idxs,
+        int ncols,
+        int k) {
+    const int tid = threadIdx.x;
+    const int bid = blockIdx.x;
+
+    float best_v[TOP_K_SMALL_MAX_K];
+    int   best_i[TOP_K_SMALL_MAX_K];
+#pragma unroll
+    for (int j = 0; j < TOP_K_SMALL_MAX_K; ++j) {
+        best_v[j] = -INFINITY;
+        best_i[j] = INT32_MAX;
+    }
+
+    const int block_cols4 = ((ncols + 3) / 4 + gridDim.x - 1) / gridDim.x;
+    const int col4_begin  = bid * block_cols4;
+    const int col4_end    = min(col4_begin + block_cols4, ncols >> 2);
+
+    ggml_cuda_pdl_sync();
+
+    if (((uintptr_t) src & 15) == 0) {
+        const float4 * src4 = reinterpret_cast<const float4 *>(src);
+        for (int c4 = col4_begin + tid; c4 < col4_end; c4 += BLOCK_SIZE) {
+            const float4 v4 = src4[c4];
+            const int base  = c4 << 2;
+            top_k_small_insert(best_v, best_i, k, v4.x, base + 0);
+            top_k_small_insert(best_v, best_i, k, v4.y, base + 1);
+            top_k_small_insert(best_v, best_i, k, v4.z, base + 2);
+            top_k_small_insert(best_v, best_i, k, v4.w, base + 3);
+        }
+        if (bid == (int) gridDim.x - 1) {
+            for (int c = (ncols & ~3) + tid; c < ncols; c += BLOCK_SIZE) {
+                top_k_small_insert(best_v, best_i, k, src[c], c);
+            }
+        }
+    } else {
+        for (int c = bid * BLOCK_SIZE + tid; c < ncols; c += (int) gridDim.x * BLOCK_SIZE) {
+            top_k_small_insert(best_v, best_i, k, src[c], c);
+        }
+    }
+
+    constexpr int nwarps = BLOCK_SIZE / WARP_SIZE;
+    __shared__ float s_val[nwarps];
+    __shared__ int   s_idx[nwarps];
+    __shared__ int   s_win_idx;
+
+    const int lane = tid % WARP_SIZE;
+    const int warp = tid / WARP_SIZE;
+
+    int   head  = 0;
+    float cur_v = best_v[0];
+    int   cur_i = best_i[0];
+
+    for (int sel = 0; sel < k; ++sel) {
+        float mv = cur_v;
+        int   mi = cur_i;
+#pragma unroll
+        for (int offset = WARP_SIZE / 2; offset > 0; offset >>= 1) {
+            const float ov = ggml_cuda_shfl_xor(mv, offset, WARP_SIZE);
+            const int   oi = ggml_cuda_shfl_xor(mi, offset, WARP_SIZE);
+            if (ov > mv || (ov == mv && oi < mi)) {
+                mv = ov;
+                mi = oi;
+            }
+        }
+        if (lane == 0) {
+            s_val[warp] = mv;
+            s_idx[warp] = mi;
+        }
+        __syncthreads();
+
+        if (warp == 0) {
+            mv = (lane < nwarps) ? s_val[lane] : -INFINITY;
+            mi = (lane < nwarps) ? s_idx[lane] : INT32_MAX;
+#pragma unroll
+            for (int offset = WARP_SIZE / 2; offset > 0; offset >>= 1) {
+                const float ov = ggml_cuda_shfl_xor(mv, offset, WARP_SIZE);
+                const int   oi = ggml_cuda_shfl_xor(mi, offset, WARP_SIZE);
+                if (ov > mv || (ov == mv && oi < mi)) {
+                    mv = ov;
+                    mi = oi;
+                }
+            }
+            if (lane == 0) {
+                s_win_idx = mi;
+                tmp_vals[bid * k + sel] = mv;
+                tmp_idxs[bid * k + sel] = mi;
+            }
+        }
+        __syncthreads();
+
+        if (cur_i == s_win_idx && cur_i != INT32_MAX) {
+            ++head;
+            cur_v = -INFINITY;
+            cur_i = INT32_MAX;
+#pragma unroll
+            for (int j = 0; j < TOP_K_SMALL_MAX_K; ++j) {
+                if (j == head && j < k) {
+                    cur_v = best_v[j];
+                    cur_i = best_i[j];
+                }
+            }
+        }
+    }
+}
