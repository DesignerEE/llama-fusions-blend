+    // Schedule smaller K, V matrices before Q so they pack into Wave 0
+    entries[0] = { n[1]->src[0], n[1], GGML_CUDA_HORIZ_EPI_NONE, nullptr, nullptr };
+    entries[1] = { n[2]->src[0], n[2], GGML_CUDA_HORIZ_EPI_NONE, nullptr, nullptr };
