diff --git a/common/common.cpp b/common/common.cpp
index b009d46..91bc7d9 100644
--- a/common/common.cpp
+++ b/common/common.cpp
@@ -2421,6 +2421,135 @@ bool common_prompt_batch_decode(
     return true;
 }
 
+#include <mutex>
+
+namespace {
+struct common_pinned_state_pool {
+    struct entry {
+        uint8_t *             ptr  = nullptr;
+        size_t                cap  = 0;
+        ggml_backend_buffer_t buf  = nullptr;
+    };
+    std::mutex               mtx;
+    ggml_backend_buffer_type_t host_buft = nullptr;
+    bool                     probed    = false;
+    std::vector<entry>       free_list;
+    std::vector<entry>       active_list;
+
+    ggml_backend_buffer_type_t get_host_buft() {
+        if (!probed) {
+            probed = true;
+            const size_t n_dev = ggml_backend_dev_count();
+            for (size_t i = 0; i < n_dev; ++i) {
+                ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+                if (ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_GPU) {
+                    host_buft = ggml_backend_dev_host_buffer_type(dev);
+                    if (host_buft != nullptr) {
+                        break;
+                    }
+                }
+            }
+        }
+        return host_buft;
+    }
+};
+
+static common_pinned_state_pool & get_state_pool() {
+    static common_pinned_state_pool * pool = new common_pinned_state_pool();
+    return *pool;
+}
+} // namespace
+
+uint8_t * common_state_mem_alloc(size_t n) {
+    auto & pool = get_state_pool();
+    {
+        std::lock_guard<std::mutex> lk(pool.mtx);
+        size_t best_idx = SIZE_MAX;
+        size_t best_cap = SIZE_MAX;
+        for (size_t i = 0; i < pool.free_list.size(); ++i) {
+            const size_t cap = pool.free_list[i].cap;
+            if (cap >= n && cap <= n + 64 * 1024 * 1024 && cap < best_cap) {
+                best_cap = cap;
+                best_idx = i;
+            }
+        }
+        if (best_idx != SIZE_MAX) {
+            auto e = pool.free_list[best_idx];
+            pool.free_list.erase(pool.free_list.begin() + best_idx);
+            pool.active_list.push_back(e);
+            return e.ptr;
+        }
+    }
+
+    ggml_backend_buffer_type_t buft = nullptr;
+    {
+        std::lock_guard<std::mutex> lk(pool.mtx);
+        buft = pool.get_host_buft();
+    }
+
+    const size_t align_bytes = (n >= 64 * 1024 * 1024) ? (32 * 1024 * 1024)
+                             : (n >=  4 * 1024 * 1024) ? (16 * 1024 * 1024)
+                             : (2 * 1024 * 1024);
+    const size_t alloc_cap = (n + align_bytes - 1) & ~(align_bytes - 1);
+    ggml_backend_buffer_t buf = buft ? ggml_backend_buft_alloc_buffer(buft, alloc_cap) : nullptr;
+    uint8_t * ptr = buf ? static_cast<uint8_t *>(ggml_backend_buffer_get_base(buf))
+                        : static_cast<uint8_t *>(::operator new(alloc_cap));
+
+    std::lock_guard<std::mutex> lk(pool.mtx);
+    pool.active_list.push_back({ ptr, alloc_cap, buf });
+    return ptr;
+}
+
+void common_state_mem_prewarm(size_t n, int count) {
+    if (n < 1024 * 1024 || count <= 0) {
+        return;
+    }
+    std::vector<uint8_t *> ptrs;
+    ptrs.reserve(count);
+    for (int i = 0; i < count; ++i) {
+        ptrs.push_back(common_state_mem_alloc(n));
+    }
+    for (uint8_t * p : ptrs) {
+        common_state_mem_free(p, n);
+    }
+}
+
+void common_state_mem_free(uint8_t * p, size_t /*n*/) {
+    if (!p) {
+        return;
+    }
+    auto & pool = get_state_pool();
+    common_pinned_state_pool::entry evicted = {};
+    bool found = false;
+    {
+        std::lock_guard<std::mutex> lk(pool.mtx);
+        for (size_t i = 0; i < pool.active_list.size(); ++i) {
+            if (pool.active_list[i].ptr == p) {
+                auto e = pool.active_list[i];
+                pool.active_list.erase(pool.active_list.begin() + i);
+                pool.free_list.push_back(e);
+                found = true;
+                if (pool.free_list.size() > 128) {
+                    evicted = pool.free_list.front();
+                    pool.free_list.erase(pool.free_list.begin());
+                }
+                break;
+            }
+        }
+    }
+    if (!found) {
+        ::operator delete(p);
+        return;
+    }
+    if (evicted.ptr) {
+        if (evicted.buf) {
+            ggml_backend_buffer_free(evicted.buf);
+        } else {
+            ::operator delete(evicted.ptr);
+        }
+    }
+}
+
 size_t common_prompt_checkpoint::size() const {
     return data_tgt.size() + data_dft.size() + data_spec.size();
 }
diff --git a/common/common.h b/common/common.h
index e16bee7..87602ba 100644
--- a/common/common.h
+++ b/common/common.h
@@ -1322,6 +1322,11 @@ enum ggml_opt_optimizer_type common_opt_get_optimizer(const char *);
 // prompt utils
 //
 
+// pooled pinned-host backing for large sequence-state buffers (>= 1 MiB)
+uint8_t * common_state_mem_alloc(size_t n);
+void      common_state_mem_free(uint8_t * p, size_t n);
+void      common_state_mem_prewarm(size_t n, int count);
+
 // leave default-inserted elements uninitialized; callers must fill them before use
 template <typename T>
 struct common_no_init_allocator : std::allocator<T> {
@@ -1330,6 +1335,25 @@ struct common_no_init_allocator : std::allocator<T> {
     common_no_init_allocator() = default;
     template <typename U> common_no_init_allocator(const common_no_init_allocator<U> &) {}
 
+    T * allocate(size_t n) {
+        if constexpr (sizeof(T) == 1) {
+            if (n >= 1024 * 1024) {
+                return reinterpret_cast<T *>(common_state_mem_alloc(n));
+            }
+        }
+        return std::allocator<T>::allocate(n);
+    }
+
+    void deallocate(T * p, size_t n) noexcept {
+        if constexpr (sizeof(T) == 1) {
+            if (n >= 1024 * 1024) {
+                common_state_mem_free(reinterpret_cast<uint8_t *>(p), n);
+                return;
+            }
+        }
+        std::allocator<T>::deallocate(p, n);
+    }
+
     template <typename U> void construct(U * p) { ::new ((void *) p) U; }
 };
 
