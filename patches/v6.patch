+                const char * src      = base_ptr + int64_t(row)*rstride + int64_t(iu0)*unit_size;
+                if constexpr (unaligned) {
+                    const int off = (uintptr_t) src % 16;
+                    if (16*ic < off + unit_size) {
+                        cp_async_cg_16<0>(dst_stage + i*sram_stride + 16*ic, src - off + 16*ic);
+                    }
+                } else {
+                    cp_async_cg_16<0>(dst_stage + i*sram_stride + 16*ic, src + 16*ic);
+                }
+            }
+        }
+    };
+
+    int off_row[4] = {0};
+    if constexpr (unaligned) {
+#pragma unroll
+        for (int r = 0; r < 2; ++r) {
+            const int row = min(row0 + int(threadIdx.x)/4 + 8*r, nrows_x - 1);
+            off_row[0 + r] = (uintptr_t) (x_up   + int64_t(row)*stride_row_up)   % 16;
+            off_row[2 + r] = (uintptr_t) (x_gate + int64_t(row)*stride_row_gate) % 16;
+        }
+    }
+
+    if (!x_is_constant) {
+        ggml_cuda_pdl_sync();
+    }
+
+#pragma unroll
+    for (int stage = 0; stage < nstages - 1; ++stage) {
+        if (stage < nsteps) {
+            load_stage(stage, unit_at_step(stage));
+        }
+        cp_async_commit_group();
+    }
+    if (x_is_constant) {
+        ggml_cuda_pdl_sync();
+    }
+
+    auto load_y = [&](mmq_few_y_frag (&yf)[ncg], const int iu) {
+#pragma unroll
+        for (int c = 0; c < ncg; ++c) {
+            mmq_few_load_y(yf[c], y + (int64_t(iu)*ncg + c)*MMQ_FEW_Q8_1_INT4);
+        }
+    };
+
+    mmq_few_y_frag yf[ncg];
+    if (nsteps > 0) {
+        load_y(yf, unit_at_step(0));
+    }
+
+    float sum_up[ncg][4]   = {{0.0f}};
+    float sum_gate[ncg][4] = {{0.0f}};
+
+    for (int iter = 0; iter < nsteps; ++iter) {
+        const int iu0       = unit_at_step(iter);
+        const int step_load = iter + (nstages - 1);
+        if (step_load < nsteps) {
+            load_stage((iter + nstages - 1) % nstages, unit_at_step(step_load));
+        }
+        cp_async_commit_group();
+
+        const bool has_next = iter + 1 < nsteps;
+
+        cp_async_wait_group<nstages - 1>();
+        ggml_cuda_syncwarp();
+
+        const char * xs = ring + (iter % nstages)*nbytes_stage;
+        const int off_stage = unaligned ? (iu0*unit_size) % 16 : 0;
+
+        const char * const xr_up[2] = {
+            xs + (0          + threadIdx.x/4 + 0)*sram_stride + (off_row[0] + off_stage) % 16,
+            xs + (0          + threadIdx.x/4 + 8)*sram_stride + (off_row[1] + off_stage) % 16,
+        };
+        mmq_few_vec_dot<type, ncg>(xr_up, yf, sum_up);
+
+        const char * const xr_gate[2] = {
+            xs + (nrows_tile + threadIdx.x/4 + 0)*sram_stride + (off_row[2] + off_stage) % 16,
+            xs + (nrows_tile + threadIdx.x/4 + 8)*sram_stride + (off_row[3] + off_stage) % 16,
+        };
+        mmq_few_vec_dot<type, ncg>(xr_gate, yf, sum_gate);
+
+        if (has_next) {
+            load_y(yf, unit_at_step(iter + 1));
+        }
+
+        ggml_cuda_syncwarp();
+    }
+    cp_async_wait_all();
+
+    ggml_cuda_pdl_lc();
+
+    {
+        constexpr int nsum_half = ncg * 4;
+        constexpr int nsum_tot  = 2 * nsum_half;
+        float * sum_up_flat   = &sum_up[0][0];
+        float * sum_gate_flat = &sum_gate[0][0];
+
+        float * buf_sum = (float *) data_mmq_few;
+        __syncthreads();
+        if (threadIdx.y > 0) {
+#pragma unroll
+            for (int i = 0; i < nsum_half; ++i) {
+                buf_sum[((threadIdx.y - 1)*nsum_tot + i)*warp_size + threadIdx.x]             = sum_up_flat[i];
+                buf_sum[((threadIdx.y - 1)*nsum_tot + nsum_half + i)*warp_size + threadIdx.x] = sum_gate_flat[i];
+            }
+        }
+        __syncthreads();
+        if (threadIdx.y > 0) {
+            return;
+        }
+#pragma unroll
+        for (int w = 0; w < nwarps - 1; ++w) {
+#pragma unroll
+            for (int i = 0; i < nsum_half; ++i) {
+                sum_up_flat[i]   += buf_sum[(w*nsum_tot + i)*warp_size + threadIdx.x];
+                sum_gate_flat[i] += buf_sum[(w*nsum_tot + nsum_half + i)*warp_size + threadIdx.x];
+            }
+        }
+    }
+
+#pragma unroll
+    for (int c = 0; c < ncg; ++c) {
+#pragma unroll
+        for (int l = 0; l < 4; ++l) {
+            const int i = row0 + tile<16, 8, int>::get_i(l);
+            const int j = c*MMQ_FEW_NCOLS + tile<16, 8, int>::get_j(l);
+            if (i < nrows_x && j < ncols_dst) {
+                float u = sum_up[c][l];
+                float g = sum_gate[c][l];
+                float res;
+                switch (glu_op) {
+                    case GGML_GLU_OP_SWIGLU:
+                        res = u * ggml_cuda_op_silu_single(g);
+                        break;
+                    case GGML_GLU_OP_GEGLU:
+                        res = u * ggml_cuda_op_gelu_single(g);
+                        break;
+                    case GGML_GLU_OP_SWIGLU_OAI:
+                        res = ggml_cuda_op_swiglu_oai_single(g, u);
+                        break;
+                    case GGML_GLU_OP_SWIGLU_CLAMP:
+                        res = ggml_cuda_op_swiglu_clamp_single(g, u, glu_limit);
+                        break;
+                    default:
+                        res = u * g;
+                        break;
+                }
+                dst[int64_t(j)*stride_col_dst + i] = res;
+            }
+        }
+    }
+#else
+    GGML_UNUSED_VARS(x_up, x_gate, y_ptr, dst, nunits, nrows_x, ncols_dst,
+        stride_row_up, stride_row_gate, stride_col_dst,
+        channel_ratio, stride_channel_up, stride_channel_gate, stride_channel_dst,
+        sample_ratio, stride_sample_up, stride_sample_gate, stride_sample_dst,
+        x_is_constant, glu_op, glu_limit);
+    NO_DEVICE_CODE;
+#endif
+}
+
+template <ggml_type type, int ncg>
+static void launch_mul_mat_q_few_glu(const ggml_tensor * src0_up, const ggml_tensor * src0_gate, const ggml_tensor * src1, ggml_tensor * dst,
+        const int4 * src1_q, const ggml_glu_op glu_op, const float glu_limit, cudaStream_t stream) {
+    const int64_t ne00 = src0_up->ne[0];
+    const int64_t ne01 = src0_up->ne[1];
+    const int64_t ne02 = src0_up->ne[2];
+    const int64_t ne03 = src0_up->ne[3];
+    const int64_t ne12 = src1->ne[2];
+    const int64_t ne13 = src1->ne[3];
+    const int64_t ne1  = dst->ne[1];
+
+    const int nunits      = ne00 / QK_K;
+    const int warp_size   = ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size;
+    const int sram_stride = mmq_few_sram_stride(type, 1);
+    const int nbytes_sh   = MMQ_FEW_NWARPS * 2 * (2 * MMQ_FEW_NROWS) * sram_stride;
+    CUDA_SET_SHARED_MEMORY_LIMIT((mul_mat_q_few_glu<type, ncg>), nbytes_sh);
+
+    const bool x_const = mmq_few_is_constant(src0_up) && mmq_few_is_constant(src0_gate);
+    const dim3 block_nums((ne01 + MMQ_FEW_NROWS - 1) / MMQ_FEW_NROWS, ne12, ne13);
+    const dim3 block_dims(warp_size, MMQ_FEW_NWARPS, 1);
+    const ggml_cuda_kernel_launch_params params(block_nums, block_dims, nbytes_sh, stream);
+    ggml_cuda_kernel_launch(mul_mat_q_few_glu<type, ncg>, params,
+        (const char *) src0_up->data, (const char *) src0_gate->data, src1_q, (float *) dst->data,
+        nunits, (int) ne01, (int) ne1,
+        (int64_t) src0_up->nb[1], (int64_t) src0_gate->nb[1], (int) (dst->nb[1]/sizeof(float)),
+        (int) (ne12/ne02), (int64_t) src0_up->nb[2], (int64_t) src0_gate->nb[2], (int) (dst->nb[2]/sizeof(float)),
+        (int) (ne13/ne03), (int64_t) src0_up->nb[3], (int64_t) src0_gate->nb[3], (int) (dst->nb[3]/sizeof(float)),
+        x_const, glu_op, glu_limit);
+}
+
+bool ggml_cuda_should_fuse_mul_mat_q_few_glu(const ggml_tensor * up, const ggml_tensor * gate, const ggml_tensor * glu, const int cc) {
+    if (!up || !gate || !glu) {
+        return false;
+    }
+    if (ggml_get_op_params_i32(up, 1) != GGML_HINT_NONE || ggml_get_op_params_i32(gate, 1) != GGML_HINT_NONE) {
+        return false;
+    }
+    const ggml_tensor * x_up   = up->src[0];
+    const ggml_tensor * x_gate = gate->src[0];
+    const ggml_tensor * y      = up->src[1];
+    if (x_up->type != x_gate->type || y != gate->src[1] || y->type != GGML_TYPE_F32 || glu->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (y->ne[1] > MMQ_FEW_NCOLS) {
+        return false;
+    }
+    if (x_up->type != GGML_TYPE_Q4_K && x_up->type != GGML_TYPE_Q5_K && x_up->type != GGML_TYPE_Q6_K) {
+        return false;
+    }
+    if (!ggml_are_same_shape(x_up, x_gate) || !ggml_is_contiguous(glu)) {
+        return false;
+    }
+    if (!ggml_cuda_should_use_mmq_few(x_up, y, nullptr, cc) || !ggml_cuda_should_use_mmq_few(x_gate, y, nullptr, cc)) {
+        return false;
+    }
+    return true;
+}
+
+void ggml_cuda_mul_mat_q_few_glu(ggml_backend_cuda_context & ctx, const ggml_tensor * src0_up, const ggml_tensor * src1, ggml_tensor * dst, const ggml_cuda_mm_fusion_args_host * fusion) {
+    GGML_ASSERT(fusion && fusion->gate);
+    const ggml_tensor * src0_gate = fusion->gate;
+    cudaStream_t stream = ctx.stream();
+
+    const int64_t ne00 = src0_up->ne[0];
+    const int64_t ne10 = src1->ne[0];
+    const int64_t ne11 = src1->ne[1];
+    const int64_t ne12 = src1->ne[2];
+    const int64_t ne13 = src1->ne[3];
+    const int     nunits = ne00 / QK_K;
+    const int     ncg    = mmq_few_ncg(ne11);
+    GGML_ASSERT(ncg == 1);
+
+    ggml_cuda_pool_alloc<int4> src1_q(ctx.pool());
+    const int4 * src1_q_ptr = nullptr;
+    const bool need_ds4 = mmq_few_ds_layout(src0_up->type) == MMQ_Q8_1_DS_LAYOUT_DS4;
+    if (ctx.prequant_matches(src1, need_ds4, !need_ds4)) {
+        src1_q_ptr = need_ds4 ? ctx.prequant_ds4 : ctx.prequant_d4;
+    } else {
+        src1_q.alloc(int64_t(ne12)*ne13*nunits*ncg*MMQ_FEW_Q8_1_INT4);
+        quantize_mmq_few_q8_1_cuda((const float *) src1->data, src1_q.get(), mmq_few_ds_layout(src0_up->type),
+            ne10, src1->nb[1]/sizeof(float), src1->nb[2]/sizeof(float), src1->nb[3]/sizeof(float),
+            ne11, ne12, ne13, stream);
+        src1_q_ptr = src1_q.get();
+    }
+
+    switch (src0_up->type) {
+        case GGML_TYPE_Q4_K: launch_mul_mat_q_few_glu<GGML_TYPE_Q4_K, 1>(src0_up, src0_gate, src1, dst, src1_q_ptr, fusion->glu_op, fusion->glu_limit, stream); break;
+        case GGML_TYPE_Q5_K: launch_mul_mat_q_few_glu<GGML_TYPE_Q5_K, 1>(src0_up, src0_gate, src1, dst, src1_q_ptr, fusion->glu_op, fusion->glu_limit, stream); break;
+        case GGML_TYPE_Q6_K: launch_mul_mat_q_few_glu<GGML_TYPE_Q6_K, 1>(src0_up, src0_gate, src1, dst, src1_q_ptr, fusion->glu_op, fusion->glu_limit, stream); break;
+        default: GGML_ABORT("unsupported type for mul_mat_q_few_glu");
+    }
+}
+
+template <int ncg>
+__launch_bounds__(MMQ_FEW_NWARPS*ggml_cuda_get_physical_warp_size(), 1)
+static __global__ void mul_mat_q_few_horiz_kernel(
+        const ggml_cuda_horiz_mm_dev_args args, const int4 * y_ds4, const int4 * y_d4,
+        const int nunits, const int ncols_dst) {
+#if defined(CP_ASYNC_AVAILABLE)
+    constexpr int nwarps    = MMQ_FEW_NWARPS;
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    static_assert(warp_size == WARP_SIZE, "unsupported warp size");
+
+    extern __shared__ char data_mmq_few[];
+
+    const int bid = blockIdx.x;
+    int mat_idx = 0;
+#pragma unroll
+    for (int m = 0; m < GGML_CUDA_HORIZ_MAX_MATS; ++m) {
+        if (m < args.n_mats && bid >= args.items[m].block_start && bid < args.items[m].block_end) {
+            mat_idx = m;
+        }
+    }
+    const ggml_cuda_horiz_mm_dev_item item = args.items[mat_idx];
+    const int local_blk = bid - item.block_start;
+    const int row0      = local_blk * MMQ_FEW_NROWS;
+
+    float sum[ncg][4] = {{0.0f}};
+
+    if (item.type_id == GGML_TYPE_Q4_K) {
+        constexpr ggml_type type      = GGML_TYPE_Q4_K;
+        constexpr int  unit_size      = mmq_few_unit_size(type);        // 144
+        constexpr int  nunits_stage   = mmq_few_nunits_stage(type, ncg, 1);
+        constexpr int  nstages        = 2;
+        constexpr int  nchunks        = mmq_few_nchunks(type, nunits_stage);
+        constexpr int  sram_stride    = mmq_few_sram_stride(type, nunits_stage);
+        constexpr int  nrows          = MMQ_FEW_NROWS;                  // 16
+        constexpr int  nbytes_stage   = nrows * sram_stride;
+        constexpr int  ncopies        = nrows * nchunks;
+        const int      iu_begin       = nunits_stage * threadIdx.y;
+        const int      iu_step        = nunits_stage * nwarps;
+        const int4 * GGML_CUDA_RESTRICT y = y_ds4;
+
+        char * ring = data_mmq_few + threadIdx.y * nstages * nbytes_stage;
+
+        auto load_stage = [&](const int stage, const int iu0) {
+            const unsigned int dst_stage = ggml_cuda_cvta_generic_to_shared(ring + stage*nbytes_stage);
+#pragma unroll
+            for (int c0 = 0; c0 < ncopies; c0 += warp_size) {
+                const int c = c0 + threadIdx.x;
+                if (ncopies % warp_size == 0 || c < ncopies) {
+                    const int i   = c / nchunks;
+                    const int ic  = c % nchunks;
+                    const int row = min(row0 + i, item.nrows_x - 1);
+                    const char * src = item.x + int64_t(row)*item.stride_row_x + int64_t(iu0)*unit_size;
+                    cp_async_cg_16<0>(dst_stage + i*sram_stride + 16*ic, src + 16*ic);
+                }
+            }
+        };
+
+        if (iu_begin < nunits) {
+            load_stage(0, iu_begin);
+        }
+        cp_async_commit_group();
+        ggml_cuda_pdl_sync();
+
+        mmq_few_y_frag yf[nunits_stage][ncg];
+        if (iu_begin < nunits) {
+#pragma unroll
+            for (int k = 0; k < nunits_stage; ++k) {
+#pragma unroll
+                for (int c = 0; c < ncg; ++c) {
+                    mmq_few_load_y(yf[k][c], y + (int64_t(iu_begin + k)*ncg + c)*MMQ_FEW_Q8_1_INT4);
+                }
+            }
+        }
+
+        for (int iter = 0, iu0 = iu_begin; iu0 < nunits; ++iter, iu0 += iu_step) {
+            const int iu_load = iu0 + iu_step;
+            if (iu_load < nunits) {
+                load_stage((iter + 1) % nstages, iu_load);
+            }
+            cp_async_commit_group();
+
+            const bool has_next = iu0 + iu_step < nunits;
+            cp_async_wait_group<1>();
+            ggml_cuda_syncwarp();
+
+            const char * xs = ring + (iter % nstages)*nbytes_stage;
+#pragma unroll
+            for (int k = 0; k < nunits_stage; ++k) {
+                const char * const xr[2] = {
+                    xs + (threadIdx.x/4 + 0)*sram_stride + k*unit_size,
+                    xs + (threadIdx.x/4 + 8)*sram_stride + k*unit_size,
+                };
+                mmq_few_vec_dot<type, ncg>(xr, yf[k], sum);
+                if (has_next) {
+#pragma unroll
+                    for (int c = 0; c < ncg; ++c) {
+                        mmq_few_load_y(yf[k][c], y + (int64_t(iu0 + iu_step + k)*ncg + c)*MMQ_FEW_Q8_1_INT4);
+                    }
+                }
+            }
+            ggml_cuda_syncwarp();
+        }
+        cp_async_wait_all();
+    } else {
+        // GGML_TYPE_Q6_K
+        constexpr ggml_type type      = GGML_TYPE_Q6_K;
+        constexpr int  unit_size      = mmq_few_unit_size(type); // 210
+        constexpr int  nstages        = 3;
+        constexpr int  nchunks        = mmq_few_nchunks(type, 1);
+        constexpr int  sram_stride    = mmq_few_sram_stride(type, 1);
+        constexpr int  nrows          = 16;
+        constexpr int  nbytes_stage   = nrows * sram_stride;
+        constexpr int  ncopies        = nrows * nchunks;
+        const int      iu_begin       = threadIdx.y;
+        const int      iu_step        = nwarps;
+        const int4 * GGML_CUDA_RESTRICT y = y_d4;
+
+        char * ring = data_mmq_few + threadIdx.y * nstages * nbytes_stage;
+
+        auto load_stage = [&](const int stage, const int iu0) {
+            const unsigned int dst_stage = ggml_cuda_cvta_generic_to_shared(ring + stage*nbytes_stage);
+#pragma unroll
+            for (int c0 = 0; c0 < ncopies; c0 += warp_size) {
+                const int c = c0 + threadIdx.x;
+                if (ncopies % warp_size == 0 || c < ncopies) {
+                    const int i   = c / nchunks;
+                    const int ic  = c % nchunks;
+                    const int row = min(row0 + i, item.nrows_x - 1);
+                    const char * src = item.x + int64_t(row)*item.stride_row_x + int64_t(iu0)*unit_size;
+                    const int off = (uintptr_t) src % 16;
+                    if (16*ic < off + unit_size) {
+                        cp_async_cg_16<0>(dst_stage + i*sram_stride + 16*ic, src - off + 16*ic);
+                    }
+                }
+            }
+        };
+
+        int off_row[2];
+#pragma unroll
+        for (int r = 0; r < 2; ++r) {
+            const int row = min(row0 + int(threadIdx.x)/4 + 8*r, item.nrows_x - 1);
+            off_row[r] = (uintptr_t) (item.x + int64_t(row)*item.stride_row_x) % 16;
+        }
+
+#pragma unroll
+        for (int stage = 0; stage < nstages - 1; ++stage) {
+            const int iu0 = iu_begin + stage*iu_step;
+            if (iu0 < nunits) {
+                load_stage(stage, iu0);
+            }
+            cp_async_commit_group();
+        }
+        ggml_cuda_pdl_sync();
+
+        mmq_few_y_frag yf[ncg];
+        if (iu_begin < nunits) {
+#pragma unroll
+            for (int c = 0; c < ncg; ++c) {
+                mmq_few_load_y(yf[c], y + (int64_t(iu_begin)*ncg + c)*MMQ_FEW_Q8_1_INT4);
+            }
+        }
+
+        for (int iter = 0, iu0 = iu_begin; iu0 < nunits; ++iter, iu0 += iu_step) {
+            const int iu_load = iu0 + (nstages - 1)*iu_step;
+            if (iu_load < nunits) {
+                load_stage((iter + nstages - 1) % nstages, iu_load);
+            }
+            cp_async_commit_group();
+
+            cp_async_wait_group<nstages - 1>();
+            ggml_cuda_syncwarp();
+
+            const char * xs = ring + (iter % nstages)*nbytes_stage;
+            const int off_stage = (iu0*unit_size) % 16;
+            const char * const xr[2] = {
+                xs + (threadIdx.x/4 + 0)*sram_stride + (off_row[0] + off_stage) % 16,
+                xs + (threadIdx.x/4 + 8)*sram_stride + (off_row[1] + off_stage) % 16,
+            };
+            mmq_few_vec_dot<type, ncg>(xr, yf, sum);
+            if (iu0 + iu_step < nunits) {
+#pragma unroll
+                for (int c = 0; c < ncg; ++c) {
+                    mmq_few_load_y(yf[c], y + (int64_t(iu0 + iu_step)*ncg + c)*MMQ_FEW_Q8_1_INT4);
+                }
+            }
+            ggml_cuda_syncwarp();
+        }
+        cp_async_wait_all();
+    }
+
+    ggml_cuda_pdl_lc();
+
+    {
+        constexpr int nsum = ncg * 4;
+        float * sum_flat = &sum[0][0];
+        float * buf_sum  = (float *) data_mmq_few;
+        __syncthreads();
+        if (threadIdx.y > 0) {
+#pragma unroll
+            for (int i = 0; i < nsum; ++i) {
+                buf_sum[((threadIdx.y - 1)*nsum + i)*warp_size + threadIdx.x] = sum_flat[i];
+            }
+        }
+        __syncthreads();
+        if (threadIdx.y > 0) {
+            return;
+        }
+#pragma unroll
+        for (int w = 0; w < nwarps - 1; ++w) {
+#pragma unroll
+            for (int i = 0; i < nsum; ++i) {
+                sum_flat[i] += buf_sum[(w*nsum + i)*warp_size + threadIdx.x];
+            }
+        }
+    }
+
+#pragma unroll
+    for (int c = 0; c < ncg; ++c) {
+#pragma unroll
+        for (int l = 0; l < 4; ++l) {
+            const int i = row0 + tile<16, 8, int>::get_i(l);
+            const int j = c*MMQ_FEW_NCOLS + tile<16, 8, int>::get_j(l);
+            if (i < item.nrows_x && j < ncols_dst) {
+                float val = sum[c][l];
+                if (item.epilogue == GGML_CUDA_HORIZ_EPI_SIGMOID) {
+                    val = 1.0f / (1.0f + expf(-val));
+                } else if (item.epilogue == GGML_CUDA_HORIZ_EPI_ADD_SOFTPLUS_MUL) {
+                    const float xb = val + item.bias_dt[i];
+                    const float sp = (xb > 20.0f) ? xb : log1pf(expf(xb));
+                    val = sp * item.scale_a[i];
+                }
+                item.dst[int64_t(j)*item.stride_col_dst + i] = val;
+            }
+        }
+    }
+#else
+    GGML_UNUSED_VARS(args, y_ds4, y_d4, nunits, ncols_dst);
+    NO_DEVICE_CODE;
+#endif
+}
+
+bool ggml_cuda_can_use_mmq_few_horiz(const ggml_cuda_horiz_mm_entry * entries, const int n_mats, const ggml_tensor * src1, const int cc) {
+    if (n_mats < 2 || n_mats > GGML_CUDA_HORIZ_MAX_MATS || !src1) {
+        return false;
+    }
+    if (src1->type != GGML_TYPE_F32 || src1->ne[1] > MMQ_FEW_NCOLS || src1->ne[2] != 1 || src1->ne[3] != 1 || src1->ne[0] % QK_K != 0) {
+        return false;
+    }
+    for (int m = 0; m < n_mats; ++m) {
+        const ggml_tensor * x = entries[m].src0;
+        const ggml_tensor * d = entries[m].dst;
+        if (!x || !d || d->type != GGML_TYPE_F32) {
+            return false;
+        }
+        if ((x->type != GGML_TYPE_Q4_K && x->type != GGML_TYPE_Q6_K) || !mmq_few_is_constant(x)) {
+            return false;
+        }
+        if (x->ne[0] != src1->ne[0] || x->ne[1] % MMQ_FEW_NROWS != 0 || x->ne[2] != 1 || x->ne[3] != 1) {
+            return false;
+        }
+        if (!ggml_cuda_should_use_mmq_few(x, src1, nullptr, cc)) {
+            return false;
+        }
+    }
+    return true;
+}
