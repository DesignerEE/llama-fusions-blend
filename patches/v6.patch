+    fused_cache.src_rows   = (const int32_t *) rows_idx->data;
+    fused_cache.src_stride = (int64_t) (states_src->nb[1] / sizeof(float));
+    gdn_idx_out            = gdn_idx;
+    return last_idx - node_idx;
+}
