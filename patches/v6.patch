+void ggml_cuda_mul_mat_vec_q_horiz(ggml_backend_cuda_context & ctx, const ggml_cuda_horiz_mm_entry * entries, const int n_mats, const ggml_tensor * src1) {
+    cudaStream_t stream = ctx.stream();
+    const int64_t ne10 = src1->ne[0];
+    const int64_t ne11 = src1->ne[1];
+    const int64_t ne10_padded = GGML_PAD(ne10, MATRIX_ROW_PADDING);
+
+    ggml_cuda_pool_alloc<char> src1_q8_1(ctx.pool(), ne11 * ne10_padded * sizeof(block_q8_1) / QK8_1);
+    quantize_row_q8_1_cuda((const float *) src1->data, src1_q8_1.get(),
+        ne10, src1->nb[1]/sizeof(float), src1->nb[2]/sizeof(float), src1->nb[3]/sizeof(float),
+        ne10_padded, ne11, 1, 1, stream);
+
+    const int rpb = 2;
+    ggml_cuda_horiz_mm_dev_args dev_args = {};
+    dev_args.n_mats = n_mats;
+    int total_blocks = 0;
+
+    for (int m = 0; m < n_mats; ++m) {
+        const ggml_tensor * x = entries[m].src0;
+        ggml_tensor *       d = entries[m].dst;
+        const int nblocks = (x->ne[1] + rpb - 1) / rpb;
+        auto & it         = dev_args.items[m];
+        it.x              = (const char *) x->data;
+        it.dst            = (float *) d->data;
+        it.bias_dt        = entries[m].bias_dt ? (const float *) entries[m].bias_dt->data : nullptr;
+        it.scale_a        = entries[m].scale_a ? (const float *) entries[m].scale_a->data : nullptr;
+        it.stride_row_x   = (int64_t) (x->nb[1] / ggml_type_size(x->type));
+        it.stride_col_dst = (int) x->ne[1];
+        it.nrows_x        = (int) x->ne[1];
+        it.block_start    = total_blocks;
+        it.block_end      = total_blocks + nblocks;
+        it.type_id        = (int) x->type;
+        it.rows_per_blk   = rpb;
+        it.epilogue       = entries[m].epilogue;
+        total_blocks     += nblocks;
+    }
+
+    const int warp_size = ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size;
+    const dim3 block_nums(total_blocks, 1, 1);
+    const dim3 block_dims(warp_size, 4, 1);
+    const ggml_cuda_kernel_launch_params params(block_nums, block_dims, 0, stream);
+    const int s11 = ne10_padded / QK8_1;
+
+    switch (ne11) {
+        case 1: ggml_cuda_kernel_launch((mul_mat_vec_q_horiz_kernel<1, 2>), params, dev_args, src1_q8_1.get(), (int) ne10, s11); break;
+        case 2: ggml_cuda_kernel_launch((mul_mat_vec_q_horiz_kernel<2, 2>), params, dev_args, src1_q8_1.get(), (int) ne10, s11); break;
+        case 3: ggml_cuda_kernel_launch((mul_mat_vec_q_horiz_kernel<3, 2>), params, dev_args, src1_q8_1.get(), (int) ne10, s11); break;
+        case 4: ggml_cuda_kernel_launch((mul_mat_vec_q_horiz_kernel<4, 2>), params, dev_args, src1_q8_1.get(), (int) ne10, s11); break;
+        case 5: ggml_cuda_kernel_launch((mul_mat_vec_q_horiz_kernel<5, 2>), params, dev_args, src1_q8_1.get(), (int) ne10, s11); break;
+        default: GGML_ABORT("unsupported ne11");
+    }
+}
