+// Verify that eliding all nodes in [first_idx, last_idx] except keep_output_idx is sound:
+// every elided node must be a non-output compute node whose uses all lie strictly inside [first_idx, last_idx].
+static bool ggml_cuda_can_elide_to_single_output(
+        const ggml_cgraph * cgraph, int first_idx, int last_idx, int keep_output_idx) {
+    if (first_idx < 0 || last_idx >= cgraph->n_nodes || keep_output_idx < first_idx || keep_output_idx > last_idx) {
+        return false;
+    }
+    for (int k = first_idx; k <= last_idx; ++k) {
+        const ggml_tensor * node = cgraph->nodes[k];
+        if ((node->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            return false;
+        }
+        if (k == keep_output_idx) {
+            continue;
+        }
+        if (node->flags & GGML_TENSOR_FLAG_OUTPUT) {
+            return false;
+        }
+        int internal_uses = 0;
+        for (int j = k + 1; j <= last_idx; ++j) {
+            const ggml_tensor * other = cgraph->nodes[j];
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                if (other->src[s] == node) {
+                    internal_uses++;
+                }
+            }
+        }
+        if (internal_uses != ggml_node_get_use_count(cgraph, k)) {
+            return false;
+        }
+    }
+    return true;
+}
