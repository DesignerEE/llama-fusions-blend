+// Fuse GET_ROWS(conv_states_all, s_copy_main) + RESHAPE + TRANSPOSE + CONCAT + [VIEWs] + SET_ROWS/CPY + SSM_CONV [+ SILU]
+static int ggml_cuda_try_ssm_conv_state_fusion(
+        const ggml_cgraph * cgraph, int node_idx, ggml_cuda_ssm_conv_state_fused_args & args) {
+    // Disabled in sub_3 after ablation isolated KL drift (0.412 PUB / 0.164 HID) to this path
+    GGML_UNUSED_VARS(cgraph, node_idx, args);
+    return 0;
+    const ggml_tensor * get_rows = cgraph->nodes[node_idx];
+    if (get_rows->op != GGML_OP_GET_ROWS || get_rows->type != GGML_TYPE_F32 ||
+        (get_rows->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return 0;
+    }
+    const ggml_tensor * conv_states_src = get_rows->src[0];
+    const ggml_tensor * s_copy_main     = get_rows->src[1];
+    if (!conv_states_src || !s_copy_main || conv_states_src->type != GGML_TYPE_F32 ||
+        s_copy_main->type != GGML_TYPE_I32 || conv_states_src->nb[0] != sizeof(float) ||
+        get_rows->ne[1] != 1 || get_rows->ne[2] != 1 || get_rows->ne[3] != 1) {
+        return 0;
+    }
+
+    int concat_idx = -1;
+    for (int j = node_idx + 1; j < cgraph->n_nodes && j <= node_idx + 10; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(n)) {
+            continue;
+        }
+        if (n->op == GGML_OP_CONCAT) {
+            concat_idx = j;
+        }
+        break;
+    }
+    if (concat_idx < 0) {
+        return 0;
+    }
+
+    const ggml_tensor * concat = cgraph->nodes[concat_idx];
+    if (concat->type != GGML_TYPE_F32 || (concat->flags & GGML_TENSOR_FLAG_OUTPUT) ||
+        ggml_get_op_params_i32(concat, 0) != 0 || !ggml_is_contiguous(concat)) {
+        return 0;
+    }
+    const ggml_tensor * hist_3d = concat->src[0];
+    const ggml_tensor * qkv_t   = concat->src[1];
+    if (!hist_3d || !qkv_t || hist_3d->view_src != get_rows || hist_3d->view_offs != 0 ||
+        hist_3d->ne[0] != 3 || qkv_t->type != GGML_TYPE_F32 || qkv_t->nb[1] != sizeof(float)) {
+        return 0;
+    }
+
+    const int64_t nr   = concat->ne[1];
+    const int64_t n_s  = concat->ne[2];
+    const int64_t n_t  = qkv_t->ne[0];
+    if (n_s != 1 || concat->ne[3] != 1 || nr <= 0 || (nr % 128) != 0 ||
+        get_rows->ne[0] != 3 * nr || n_t < 1 || n_t > 32) {
+        return 0;
+    }
+
+    int store_idx = -1;
+    for (int j = concat_idx + 1; j < cgraph->n_nodes && j <= concat_idx + 6; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(n)) {
+            continue;
+        }
+        if (n->op == GGML_OP_SET_ROWS || n->op == GGML_OP_CPY) {
+            store_idx = j;
+        }
+        break;
+    }
+    if (store_idx < 0) {
+        return 0;
+    }
+
+    const ggml_tensor * store_node = cgraph->nodes[store_idx];
+    if (store_node->flags & GGML_TENSOR_FLAG_OUTPUT) {
+        return 0;
+    }
+
+    float * slots_dst = nullptr;
+    size_t  slots_nb1 = 0;
+    size_t  slots_nb2 = 3 * sizeof(float);
+    size_t  slots_nb3 = conv_states_src->nb[1];
+    int     Kw        = 0;
+
+    if (store_node->op == GGML_OP_SET_ROWS) {
+        const ggml_tensor * windows    = store_node->src[0];
+        const ggml_tensor * slot_order = store_node->src[1];
+        const ggml_tensor * slots      = store_node->src[2];
+        if (!windows || !slot_order || !slots || windows->op != GGML_OP_VIEW || windows->view_src != concat ||
+            slots->op != GGML_OP_VIEW || slots->type != GGML_TYPE_F32 ||
+            slots->nb[0] != sizeof(float) || slots->nb[2] != 3 * sizeof(float)) {
+            return 0;
+        }
+        Kw = (int) windows->ne[1];
