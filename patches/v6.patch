+            windows->view_offs != (size_t) (n_t - (Kw - 1)) * sizeof(float)) {
+            return 0;
+        }
+        // Verify slot_order was produced by ensure_rs_slot_rev ({Kw-1, ..., 0})
+        if (!slot_order->view_src || slot_order->type != GGML_TYPE_I32 || slot_order->ne[0] != Kw) {
+            return 0;
+        }
+        slots_dst = (float *) slots->data;
+        slots_nb1 = slots->nb[1];
+        slots_nb2 = slots->nb[2];
+        slots_nb3 = slots->nb[3];
+    } else {
+        // GGML_OP_CPY (n_rs_seq == 0)
+        const ggml_tensor * last = store_node->src[0];
+        const ggml_tensor * cell = store_node->src[1];
+        if (!last || !cell || last->op != GGML_OP_VIEW || last->view_src != concat ||
+            last->ne[0] != 3 || last->ne[1] != nr || last->ne[2] != 1 ||
+            last->view_offs != (size_t) n_t * sizeof(float) ||
+            cell->op != GGML_OP_VIEW || cell->type != GGML_TYPE_F32 ||
+            cell->ne[0] != 3 * nr || cell->ne[1] != 1 || cell->nb[0] != sizeof(float)) {
+            return 0;
+        }
+        Kw        = 1;
+        slots_dst = (float *) cell->data;
+        slots_nb1 = 0;
+        slots_nb2 = 3 * sizeof(float);
+        slots_nb3 = cell->nb[1];
+    }
+
+    int conv_idx = -1;
+    for (int j = store_idx + 1; j < cgraph->n_nodes && j <= store_idx + 3; ++j) {
+        const ggml_tensor * n = cgraph->nodes[j];
+        if (ggml_cuda_is_view_or_noop(n)) {
+            continue;
+        }
+        if (n->op == GGML_OP_SSM_CONV) {
+            conv_idx = j;
+        }
+        break;
+    }
+    if (conv_idx < 0) {
+        return 0;
+    }
+
+    const ggml_tensor * ssm_conv = cgraph->nodes[conv_idx];
+    if (ssm_conv->src[0] != concat || ssm_conv->type != GGML_TYPE_F32 ||
+        ssm_conv->src[1]->ne[0] != 4 || ssm_conv->src[1]->nb[0] != sizeof(float)) {
+        return 0;
+    }
+
+    int out_idx = conv_idx;
+    ggml_tensor * silu_dst = nullptr;
+    if (conv_idx + 1 < cgraph->n_nodes && !(ssm_conv->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        ggml_tensor * next_n = cgraph->nodes[conv_idx + 1];
+        if (next_n->op == GGML_OP_UNARY && next_n->src[0] == ssm_conv &&
+            next_n->type == GGML_TYPE_F32 && ggml_get_unary_op(next_n) == GGML_UNARY_OP_SILU) {
+            out_idx  = conv_idx + 1;
+            silu_dst = next_n;
+        }
+    }
+
+    if (!ggml_cuda_can_elide_to_single_output(cgraph, node_idx, out_idx, out_idx)) {
+        return 0;
+    }
+
+    // Check output tensor byte range does not overlap qkv_t or conv_states_src
+    const ggml_tensor * final_out = cgraph->nodes[out_idx];
+    const ggml_tensor * qkv_base  = qkv_t->view_src ? qkv_t->view_src : qkv_t;
+    const uintptr_t out_lo = (uintptr_t) final_out->data;
+    const uintptr_t out_hi = out_lo + ggml_nbytes(final_out);
+    const uintptr_t qkv_lo = (uintptr_t) qkv_base->data;
+    const uintptr_t qkv_hi = qkv_lo + ggml_nbytes(qkv_base);
+    if ((out_lo < qkv_hi && qkv_lo < out_hi) || final_out->data == conv_states_src->data) {
+        return 0;
+    }
+
+    args.conv_states_all = (const float *) conv_states_src->data;
+    args.conv_state_nb1  = conv_states_src->nb[1];
+    args.s_copy_main     = (const int32_t *) s_copy_main->data;
+    args.qkv_t           = (const float *) qkv_t->data;
+    args.qkv_t_nb0       = qkv_t->nb[0];
+    args.qkv_t_nb2       = qkv_t->nb[2];
+    args.slots_dst       = slots_dst;
+    args.slots_nb1       = slots_nb1;
+    args.slots_nb2       = slots_nb2;
+    args.slots_nb3       = slots_nb3;
+    args.Kw              = Kw;
+    args.ssm_conv        = ssm_conv;
+    args.silu_dst        = silu_dst;
+    return out_idx - node_idx;
+}
