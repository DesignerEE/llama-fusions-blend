+void ggml_cuda_mul_mat_q_few_horiz(ggml_backend_cuda_context & ctx, const ggml_cuda_horiz_mm_entry * entries, const int n_mats, const ggml_tensor * src1) {
+    cudaStream_t stream = ctx.stream();
+    const int64_t ne00 = src1->ne[0];
+    const int64_t ne11 = src1->ne[1];
+    const int     nunits = ne00 / QK_K;
+    const int     ncg    = mmq_few_ncg(ne11);
+
+    bool need_ds4 = false;
+    bool need_d4  = false;
+    ggml_cuda_horiz_mm_dev_args dev_args = {};
+    dev_args.n_mats = n_mats;
+    int total_blocks = 0;
+
+    for (int m = 0; m < n_mats; ++m) {
+        const ggml_tensor * x = entries[m].src0;
+        ggml_tensor *       d = entries[m].dst;
+        if (x->type == GGML_TYPE_Q4_K) {
+            need_ds4 = true;
+        } else {
+            need_d4  = true;
+        }
+        const int rpb     = MMQ_FEW_NROWS;
+        const int nblocks = (x->ne[1] + rpb - 1) / rpb;
+        auto & it         = dev_args.items[m];
+        it.x              = (const char *) x->data;
+        it.dst            = (float *) d->data;
+        it.bias_dt        = entries[m].bias_dt ? (const float *) entries[m].bias_dt->data : nullptr;
+        it.scale_a        = entries[m].scale_a ? (const float *) entries[m].scale_a->data : nullptr;
+        it.stride_row_x   = (int64_t) x->nb[1];
+        it.stride_col_dst = (int) (x->ne[1]);
+        it.nrows_x        = (int) x->ne[1];
+        it.block_start    = total_blocks;
+        it.block_end      = total_blocks + nblocks;
+        it.type_id        = (int) x->type;
+        it.rows_per_blk   = rpb;
+        it.epilogue       = entries[m].epilogue;
+        total_blocks     += nblocks;
+    }
+
+    ggml_cuda_pool_alloc<int4> src1_ds4(ctx.pool());
+    ggml_cuda_pool_alloc<int4> src1_d4(ctx.pool());
+    const int4 * ds4_ptr = nullptr;
+    const int4 * d4_ptr  = nullptr;
+    const int64_t q_elems = int64_t(nunits) * ncg * MMQ_FEW_Q8_1_INT4;
+
+    if (ncg == 1 && ctx.prequant_matches(src1, need_ds4, need_d4)) {
+        ds4_ptr = need_ds4 ? ctx.prequant_ds4 : nullptr;
+        d4_ptr  = need_d4  ? ctx.prequant_d4  : nullptr;
+    } else if (need_ds4 && need_d4) {
+        src1_ds4.alloc(q_elems);
+        src1_d4.alloc(q_elems);
+        const int64_t block_num_y = (ne00 + 4*CUDA_QUANTIZE_BLOCK_SIZE_MMQ - 1) / (4*CUDA_QUANTIZE_BLOCK_SIZE_MMQ);
+        const dim3 q_blocks(GGML_PAD(ne11, MMQ_FEW_NCOLS), block_num_y, 1);
+        const dim3 q_threads(CUDA_QUANTIZE_BLOCK_SIZE_MMQ, 1, 1);
+        const ggml_cuda_kernel_launch_params q_params(q_blocks, q_threads, 0, stream);
+        ggml_cuda_kernel_launch(quantize_mmq_few_dual_q8_1, q_params,
+            (const float *) src1->data, src1_ds4.get(), src1_d4.get(),
+            ne00, (int64_t)(src1->nb[1]/sizeof(float)), (int64_t)(src1->nb[2]/sizeof(float)), (int64_t)(src1->nb[3]/sizeof(float)),
+            (int) ne11, 1);
+        ds4_ptr = src1_ds4.get();
+        d4_ptr  = src1_d4.get();
+    } else if (need_ds4) {
+        src1_ds4.alloc(q_elems);
+        quantize_mmq_few_q8_1_cuda((const float *) src1->data, src1_ds4.get(), MMQ_Q8_1_DS_LAYOUT_DS4,
+            ne00, src1->nb[1]/sizeof(float), src1->nb[2]/sizeof(float), src1->nb[3]/sizeof(float),
+            ne11, 1, 1, stream);
+        ds4_ptr = src1_ds4.get();
+    } else {
+        src1_d4.alloc(q_elems);
+        quantize_mmq_few_q8_1_cuda((const float *) src1->data, src1_d4.get(), MMQ_Q8_1_DS_LAYOUT_D4,
+            ne00, src1->nb[1]/sizeof(float), src1->nb[2]/sizeof(float), src1->nb[3]/sizeof(float),
+            ne11, 1, 1, stream);
+        d4_ptr = src1_d4.get();
+    }
+
+    const int warp_size = ggml_cuda_info().devices[ggml_cuda_get_device()].warp_size;
+    constexpr int max_nbytes_sh = MMQ_FEW_NWARPS * 3 * MMQ_FEW_NROWS * mmq_few_sram_stride(GGML_TYPE_Q6_K, 1);
+    const int nbytes_sh = need_d4
+        ? max_nbytes_sh
+        : MMQ_FEW_NWARPS * 2 * MMQ_FEW_NROWS * mmq_few_sram_stride(GGML_TYPE_Q4_K, mmq_few_nunits_stage(GGML_TYPE_Q4_K, ncg, 1));
+
+    const dim3 block_nums(total_blocks, 1, 1);
+    const dim3 block_dims(warp_size, MMQ_FEW_NWARPS, 1);
+    const ggml_cuda_kernel_launch_params params(block_nums, block_dims, nbytes_sh, stream);
+
+    GGML_ASSERT(ncg == 1);
+    CUDA_SET_SHARED_MEMORY_LIMIT((mul_mat_q_few_horiz_kernel<1>), max_nbytes_sh);
+    ggml_cuda_kernel_launch(mul_mat_q_few_horiz_kernel<1>, params, dev_args, ds4_ptr, d4_ptr, nunits, (int) ne11);
+}
