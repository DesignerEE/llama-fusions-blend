+// Match Full Attention 3-node Q, K, V horizontal projections sharing src1
+static bool ggml_cuda_match_qkv_horiz_proj(
+        const ggml_cgraph * cgraph, int i, ggml_cuda_horiz_mm_entry (&entries)[3], const ggml_tensor *& src1_out) {
+    if (i + 2 >= cgraph->n_nodes) {
+        return false;
+    }
+    if (i + 3 < cgraph->n_nodes && cgraph->nodes[i + 3]->op == GGML_OP_GLU) {
+        return false;
+    }
+    static const ggml_op pattern_ops[3] = { GGML_OP_MUL_MAT, GGML_OP_MUL_MAT, GGML_OP_MUL_MAT };
+    const int outputs[3] = { i, i + 1, i + 2 };
+    if (!ggml_can_fuse_subgraph(cgraph, i, 3, pattern_ops, outputs, 3)) {
+        return false;
+    }
+    ggml_tensor ** n = cgraph->nodes + i;
+    const ggml_tensor * src1 = n[0]->src[1];
+    if (!src1 || src1->type != GGML_TYPE_F32 || src1->nb[0] != sizeof(float) || src1->ne[2] != 1 || src1->ne[3] != 1) {
