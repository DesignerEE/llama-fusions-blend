index 053ed60..11e547f 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -1394,6 +1394,76 @@ struct ggml_backend_cuda_context {
     std::string name;
     cudaEvent_t copy_event = nullptr;
 
+    // Double-buffered pinned host staging ring for zero-sync async H2D input copies
+    static constexpr size_t H2D_STAGING_HALF_BYTES = 2 * 1024 * 1024;
+    char *      h2d_staging[2]       = { nullptr, nullptr };
+    cudaEvent_t h2d_staging_event[2] = { nullptr, nullptr };
+    int         h2d_staging_cur      = 0;
+    size_t      h2d_staging_off      = 0;
+
+    // Static device scratch for fused norm -> mmq_few q8_1 pre-quantization (100% CUDA Graph safe)
+    static constexpr int64_t PREQUANT_MAX_UNITS = 128; // up to K = 32768
+    static constexpr size_t  PREQUANT_BYTES     = PREQUANT_MAX_UNITS * 160 * sizeof(int4); // 160 = MMQ_FEW_Q8_1_INT4
+    int4 *       prequant_ds4      = nullptr;
+    int4 *       prequant_d4       = nullptr;
+    const void * prequant_src_data = nullptr;
+    int64_t      prequant_ne0      = 0;
+    int64_t      prequant_ne1      = 0;
+    bool         prequant_has_ds4  = false;
+    bool         prequant_has_d4   = false;
+    uint64_t     prequant_gen      = 0;
+
+    void ensure_prequant() {
+        if (prequant_ds4 == nullptr) {
+            ggml_cuda_set_device(device);
+            CUDA_CHECK(cudaMalloc(&prequant_ds4, PREQUANT_BYTES));
+            CUDA_CHECK(cudaMalloc(&prequant_d4,  PREQUANT_BYTES));
+        }
+    }
+
+    void clear_prequant() {
+        prequant_src_data = nullptr;
+        prequant_has_ds4  = false;
+        prequant_has_d4   = false;
+    }
+
+    bool prequant_matches(const ggml_tensor * src1, bool need_ds4, bool need_d4) const {
+        if (!src1 || prequant_src_data == nullptr || src1->data != prequant_src_data) {
+            return false;
+        }
+        if (src1->ne[0] != prequant_ne0 || src1->ne[1] != prequant_ne1 || src1->ne[2] != 1 || src1->ne[3] != 1) {
+            return false;
+        }
+        if (!ggml_is_contiguous(src1)) {
+            return false;
+        }
+        if ((need_ds4 && !prequant_has_ds4) || (need_d4 && !prequant_has_d4)) {
+            return false;
+        }
+        return true;
+    }
+
+    void * stage_h2d(const void * src, size_t size, cudaStream_t strm) {
+        if (h2d_staging[0] == nullptr) {
+            ggml_cuda_set_device(device);
+            for (int b = 0; b < 2; ++b) {
+                CUDA_CHECK(cudaHostAlloc(&h2d_staging[b], H2D_STAGING_HALF_BYTES, cudaHostAllocDefault));
+                CUDA_CHECK(cudaEventCreateWithFlags(&h2d_staging_event[b], cudaEventDisableTiming));
+            }
+        }
+        const size_t size_aligned = (size + 15) & ~size_t(15);
+        if (h2d_staging_off + size_aligned > H2D_STAGING_HALF_BYTES) {
+            CUDA_CHECK(cudaEventRecord(h2d_staging_event[h2d_staging_cur], strm));
+            h2d_staging_cur ^= 1;
+            CUDA_CHECK(cudaEventSynchronize(h2d_staging_event[h2d_staging_cur]));
+            h2d_staging_off = 0;
+        }
+        char * dst = h2d_staging[h2d_staging_cur] + h2d_staging_off;
+        memcpy(dst, src, size);
+        h2d_staging_off += size_aligned;
+        return dst;
+    }
+
     cudaStream_t streams[GGML_CUDA_MAX_DEVICES][GGML_CUDA_MAX_STREAMS] = {};
     cublasHandle_t cublas_handles[GGML_CUDA_MAX_DEVICES][GGML_CUDA_MAX_STREAMS] = {};
     void * cublas_workspaces[GGML_CUDA_MAX_DEVICES][GGML_CUDA_MAX_STREAMS] = {};
