+// =================================================================================================
+// sub_2: Horizontal multi-matrix MMVQ (ncols = 1..5) for Q4_K / Q6_K sibling projections
+// =================================================================================================
+
+template <int ncols_dst, int rows_per_blk>
+__launch_bounds__(4*ggml_cuda_get_physical_warp_size(), 1)
+static __global__ void mul_mat_vec_q_horiz_kernel(
+        const ggml_cuda_horiz_mm_dev_args args, const void * vy_ptr,
+        const int ncols_x, const int stride_col_y) {
+    constexpr int nwarps    = 4;
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    const int tid = warp_size * threadIdx.y + threadIdx.x;
+    const int bid = blockIdx.x;
+
+    int mat_idx = 0;
+#pragma unroll
+    for (int m = 0; m < GGML_CUDA_HORIZ_MAX_MATS; ++m) {
+        if (m < args.n_mats && bid >= args.items[m].block_start && bid < args.items[m].block_end) {
+            mat_idx = m;
+        }
+    }
+    const ggml_cuda_horiz_mm_dev_item item = args.items[mat_idx];
+    const int row0             = (bid - item.block_start) * rows_per_blk;
+    const int blocks_per_row_x = ncols_x / QK_K;
+    const int stride_row_x     = (int) item.stride_row_x; // in blocks
+
+    ggml_cuda_pdl_sync();
+
+    const block_q8_1 * GGML_CUDA_RESTRICT y = (const block_q8_1 *) vy_ptr;
+    const void       * GGML_CUDA_RESTRICT vx = item.x;
+    const int kbx_offset = row0 * stride_row_x;
+
+    float tmp[ncols_dst][rows_per_blk] = {{0.0f}};
+
+    if (item.type_id == GGML_TYPE_Q4_K) {
+        constexpr int qi              = ggml_cuda_type_traits<GGML_TYPE_Q4_K>::qi;
+        constexpr int vdr             = VDR_Q4_K_Q8_1_MMVQ;
+        constexpr int blocks_per_iter = vdr * nwarps * warp_size / qi;
+        for (int kbx = tid / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+            const int kby = kbx * (QK_K / QK8_1);
+            const int kqs = vdr * (tid % (qi/vdr));
+#pragma unroll
+            for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+                for (int i = 0; i < rows_per_blk; ++i) {
+                    tmp[j][i] += vec_dot_q4_K_q8_1(vx, &y[j*stride_col_y + kby], kbx_offset + i*stride_row_x + kbx, kqs);
+                }
+            }
+        }
+    } else {
+        constexpr int qi              = ggml_cuda_type_traits<GGML_TYPE_Q6_K>::qi;
+        constexpr int vdr             = VDR_Q6_K_Q8_1_MMVQ;
+        constexpr int blocks_per_iter = vdr * nwarps * warp_size / qi;
+        for (int kbx = tid / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+            const int kby = kbx * (QK_K / QK8_1);
+            const int kqs = vdr * (tid % (qi/vdr));
+#pragma unroll
+            for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+                for (int i = 0; i < rows_per_blk; ++i) {
+                    tmp[j][i] += vec_dot_q6_K_q8_1(vx, &y[j*stride_col_y + kby], kbx_offset + i*stride_row_x + kbx, kqs);
+                }
+            }
+        }
+    }
+
+    ggml_cuda_pdl_lc();
+
+    __shared__ float tmp_shared[nwarps - 1][ncols_dst][rows_per_blk][warp_size];
+    if (threadIdx.y > 0) {
+#pragma unroll
+        for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+            for (int i = 0; i < rows_per_blk; ++i) {
+                tmp_shared[threadIdx.y - 1][j][i][threadIdx.x] = tmp[j][i];
+            }
+        }
+    }
+    __syncthreads();
+    if (threadIdx.y > 0) {
+        return;
+    }
+
+    float * dst = item.dst + row0;
+#pragma unroll
+    for (int j = 0; j < ncols_dst; ++j) {
+#pragma unroll
+        for (int i = 0; i < rows_per_blk; ++i) {
+#pragma unroll
+            for (int l = 0; l < nwarps - 1; ++l) {
+                tmp[j][i] += tmp_shared[l][j][i][threadIdx.x];
+            }
+            tmp[j][i] = warp_reduce_sum<warp_size>(tmp[j][i]);
+            if (threadIdx.x == i && (rows_per_blk == 1 || (row0 + i) < item.nrows_x)) {
+                float val = tmp[j][i];
+                if (item.epilogue == GGML_CUDA_HORIZ_EPI_SIGMOID) {
+                    val = 1.0f / (1.0f + expf(-val));
+                } else if (item.epilogue == GGML_CUDA_HORIZ_EPI_ADD_SOFTPLUS_MUL) {
+                    const float xb = val + item.bias_dt[row0 + i];
+                    const float sp = (xb > 20.0f) ? xb : log1pf(expf(xb));
+                    val = sp * item.scale_a[row0 + i];
+                }
+                dst[j*item.stride_col_dst + i] = val;
+            }
+        }
+    }
+}
+
+bool ggml_cuda_can_use_mmvq_horiz(const ggml_cuda_horiz_mm_entry * entries, const int n_mats, const ggml_tensor * src1, const int cc) {
+    if (n_mats < 2 || n_mats > GGML_CUDA_HORIZ_MAX_MATS || !src1) {
+        return false;
+    }
+    if (src1->type != GGML_TYPE_F32 || src1->ne[2] != 1 || src1->ne[3] != 1 || src1->ne[0] % QK_K != 0) {
+        return false;
+    }
+    const int64_t ne11 = src1->ne[1];
+    if (ne11 < 1 || ne11 > 5) {
+        return false;
+    }
+    for (int m = 0; m < n_mats; ++m) {
+        const ggml_tensor * x = entries[m].src0;
+        const ggml_tensor * d = entries[m].dst;
+        if (!x || !d || d->type != GGML_TYPE_F32) {
+            return false;
+        }
+        if ((x->type != GGML_TYPE_Q4_K && x->type != GGML_TYPE_Q6_K) || x->ne[0] != src1->ne[0] || x->ne[2] != 1 || x->ne[3] != 1) {
+            return false;
+        }
+        if (ggml_cuda_should_use_mmq_few(x, src1, nullptr, cc) || !ggml_cuda_should_use_mmvq(x->type, cc, ne11)) {
+            return false;
+        }
+        if (ggml_backend_buffer_get_usage(x->buffer) == GGML_BACKEND_BUFFER_USAGE_COMPUTE) {
+            return false;
+        }
+    }
+    return true;
+}
